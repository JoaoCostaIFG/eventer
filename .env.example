# Required
# The public origin of your Fluxer instance.
INSTANCE_URL=https://chat.example.com

# Bot token (<application_id>.<secret>), shown once when the application is created.
BOT_TOKEN=

# Optional — defaults shown

# Channel (name, case-insensitive, or a raw channel ID) that receives event
# announcements. Resolved per guild, so it works in every guild the bot is in.
EVENTS_CHANNEL_NAME=events

# IANA time zone event dates and times are interpreted in.
TIMEZONE=UTC

# Hour (0-23, in TIMEZONE) at which all-day events (no time given) are
# announced. Birthdays usually want the morning: 9.
DEFAULT_EVENT_HOUR=9

# How often due events are checked, in seconds.
TICK_SECONDS=30

# How long (hours) after its scheduled time an event still announces — the
# catch-up window for events that came due while the bot was offline.
# Anything older is skipped silently.
GRACE_HOURS=24

# "none" keeps announcements quiet; "everyone" prefixes them with @everyone.
ANNOUNCE_MENTION=none

# Comma-separated user ids allowed to remove ANY event (everyone can add;
# creators can always remove their own).
EVENT_ADMINS=

# Base URL for links; defaults to INSTANCE_URL. Only change it if the web
# app is served from a different origin than the one you use for the API.
WEB_APP_BASE_URL=

# Direct routing overrides for same-server Docker deployments. When BOTH are set,
# instance discovery is skipped and the bot talks to the containers directly:
#   API_URL=http://api:8080
#   GATEWAY_URL=ws://gateway:8080
# (Requires the bot to be attached to the Fluxer compose network — see README.)
API_URL=
GATEWAY_URL=

# Directory for the persistent event store (mounted as a volume in Docker).
DATA_DIR=data

# Log level: debug | info | warn | error
LOG_LEVEL=info
